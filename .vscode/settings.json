{
    // --- General ---
    "git.blame.editorDecoration.enabled": true,
    "java.configuration.updateBuildConfiguration": "automatic",

    // --- Configuración de test ---
    "java.test.config": {
        "vmArgs": [
            "-Djava.util.logging.manager=org.jboss.logmanager.LogManager"
        ],
        "workingDirectory": "${workspaceFolder}"
    },
    "java.debug.settings.vmArgs": "-Djava.util.logging.manager=org.jboss.logmanager.LogManager",

    // --- Mantén indexado todo el código Java ---
    "java.project.sourcePaths": [
        "src/main/java",
        "src/test/java"
    ],

    // --- 👇 Esta línea es la clave ---
    // Excluye del TEST EXPLORER todos los tests E2E (por nombre o ruta)
    "java.test.exclude": [
        "**/e2e/**",
        "**/*E2E.java"
    ],

    // --- No ocultes nada en el file explorer ---
    "files.exclude": {},
    "search.exclude": {},

    // --- Opcional: mejora rendimiento del test runner ---
    "java.test.editor.enableShortcuts": true
}
